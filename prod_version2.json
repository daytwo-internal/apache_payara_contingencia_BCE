    "job_templates": [
    {
      "name": "bce-payara-stop-prod-gye",
      "description": "Detiene Deployment Groups puntuales de Payara en PROD GYE (ver dg_target)",
      "job_type": "run",
      "inventory_name": "BCE Contingencia - PROD",
      "project_playbook": "payara_stop.yml",
      "limit": "payara_gye",
      "credentials": [
        "SSH - Payara PROD",
        "Payara asadmin - PROD"
      ],
      "execution_groups": [
        "<COMPLETAR_TEAM>"
      ],
      "execution_environment": "Default execution environment",
      "extra_vars": {
        "dg_target": [
          "cluster-DG-adf",
          "cluster-DG-agt",
          "cluster-DG-ccc",
          "cluster-DG-cccapp",
          "cluster-DG-cds",
          "cluster-DG-col",
          "cluster-DG-sgi",
          "cluster-DG-smi",
          "cluster-DG-srp",
          "cluster-DG-sts",
          "cluster-DG-wgi"
        ]
      },
