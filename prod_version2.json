{
  "project_name": "apache_payara_contingencia_BCE",
  "responsible_area": "<COMPLETAR_AREA>",
  "repository_URL": "<COMPLETAR_URL_REPO>",
  "organization": "Banco Central del Ecuador",
  "notas_de_seguridad": [
    "Este archivo NUNCA debe contener valores reales de secretos (passwords, llaves SSH, passphrases).",
    "La sección 'credentials' declara qué credenciales deben EXISTIR (nombre + tipo), no sus valores.",
    "El pipeline debe crear la credencial vacía si no existe, y NUNCA sobreescribir un 'inputs' con secretos ya cargados manualmente en AAP.",
    "Los valores reales de cada credencial se cargan una sola vez a mano en AAP, o vía un vault/secrets-manager separado del control de versiones de este repo."
  ],
  "credential_types": [
    {
      "name": "Payara asadmin",
      "kind": "cloud",
      "estado": "ya existe en AAP",
      "inputs": {
        "fields": [
          {
            "id": "asadmin_username",
            "type": "string",
            "label": "Usuario de asadmin (File Realm)"
          },
          {
            "id": "asadmin_password",
            "type": "string",
            "label": "Password de asadmin",
            "secret": true
          }
        ],
        "required": [
          "asadmin_username",
          "asadmin_password"
        ]
      },
      "injectors": {
        "extra_vars": {
          "admin_user": "{{ asadmin_username }}",
          "payara_admin_pass": "{{ asadmin_password }}"
        }
      }
    },
    {
      "name": "Apache Passphrase",
      "kind": "cloud",
      "estado": "ya existe en AAP",
      "inputs": {
        "fields": [
          {
            "id": "passphrase",
            "type": "string",
            "label": "Apache Passphrase",
            "secret": true
          }
        ],
        "required": [
          "passphrase"
        ]
      },
      "injectors": {
        "extra_vars": {
          "apache_passphrase": "{{ passphrase }}"
        }
      }
    }
  ],
